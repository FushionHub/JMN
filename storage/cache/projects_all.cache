a:2:{s:7:"expires";i:1792074065;s:5:"value";a:6:{s:10:"jotah-ecom";a:20:{s:4:"slug";s:10:"jotah-ecom";s:5:"title";s:17:"JOTAH ECOM NG LTD";s:8:"subtitle";s:41:"FinTech & Escrow Multi-Vendor Marketplace";s:4:"role";s:23:"Founder & Lead Engineer";s:6:"client";s:17:"Jotah Ecom NG Ltd";s:4:"date";s:11:"2023 - 2024";s:8:"featured";b:1;s:15:"category_filter";s:24:"web applications fintech";s:13:"category_name";s:16:"FinTech & Escrow";s:10:"categories";a:3:{i:0;s:7:"FinTech";i:1;s:10:"E-Commerce";i:2;s:12:"Web Platform";}s:7:"summary";s:143:"Nigeria’s premier escrow-integrated multi-vendor marketplace with automated fund custody, double-entry ledger, and distributed Redis locking.";s:5:"image";s:17:"img/project/1.jpg";s:11:"image_large";s:18:"img/project/11.jpg";s:7:"metrics";a:4:{s:6:"Ledger";s:9:"100% ACID";s:6:"Status";s:16:"Production Ready";s:10:"Conversion";s:4:"+18%";s:11:"Concurrency";s:15:"Zero Race Drops";}s:5:"stack";a:7:{i:0;s:16:"PHP (Laravel 11)";i:1;s:7:"Node.js";i:2;s:10:"TypeScript";i:3;s:10:"PostgreSQL";i:4;s:5:"Redis";i:5;s:25:"AWS (SQS, S3, CloudFront)";i:6;s:6:"Docker";}s:24:"architectural_highlights";a:5:{i:0;s:231:"ACID Double-Entry Ledger: Designed and deployed a strict virtual ledger schema in PostgreSQL with debit/credit balance pairing to eliminate arbitrary balance modifications and resolve discrepancy risks at the database kernel level.";i:1;s:259:"Concurrency Control & Atomic Inventory: Deployed distributed Redis locking mechanisms (SET NX EX) combined with atomic SQL decrement queries (UPDATE products SET stock = stock - :qty WHERE stock >= :qty) to guarantee zero overselling during rapid flash-sales.";i:2;s:184:"Automated Fund Custody: Engineered an automated multi-party escrow custody engine that holds buyer payments until cryptographic or buyer-authorized delivery confirmations are verified.";i:3;s:184:"Vendor Onboarding Pipeline: Automated asynchronous parsing pipelines for merchant contracts from unstructured PDFs and Word documents, decreasing onboarding verification delays by 65%.";i:4;s:137:"Performance Surge: Elevated overall successful checkout transactions by +18% through resilient asynchronous queue processing via AWS SQS.";}s:17:"problem_statement";s:333:"Traditional Nigerian multi-vendor marketplaces suffer from severe merchant mistrust, payment fraud, race conditions during high-demand inventory flash drops, and painful bookkeeping reconciliation gaps. The challenge was building an unalterable financial transactions layer while sustaining high throughput with zero order collision.";s:8:"solution";s:323:"Architected an end-to-end cloud platform featuring Laravel 11 micro-services, an isolated double-entry accounting engine in PostgreSQL, distributed Redis locks, and an AWS CloudFront CDN delivery system. Every buyer naira is held in a segregated cryptographic escrow vault until milestone delivery conditions are satisfied.";s:7:"gallery";a:4:{i:0;s:17:"img/project/1.jpg";i:1;s:17:"img/project/2.jpg";i:2;s:17:"img/project/3.jpg";i:3;s:17:"img/project/4.jpg";}s:8:"live_url";s:21:"https://jotahecom.com";}s:12:"fusionhub-ai";a:20:{s:4:"slug";s:12:"fusionhub-ai";s:5:"title";s:16:"FusionHub AI CMS";s:8:"subtitle";s:39:"Headless AI Automation & Content Engine";s:4:"role";s:24:"Founder & Lead Architect";s:6:"client";s:20:"FusionHub AI Systems";s:4:"date";s:14:"2023 - Present";s:8:"featured";b:1;s:15:"category_filter";s:21:"ai applications cloud";s:13:"category_name";s:15:"AI & Automation";s:10:"categories";a:3:{i:0;s:7:"AI & ML";i:1;s:12:"Headless CMS";i:2;s:18:"Cloud Architecture";}s:7:"summary";s:146:"Intelligent headless CMS automating 80% of routine content drafting, synthesis, and scheduling through real-time RAG pipelines and AWS Serverless.";s:5:"image";s:17:"img/project/2.jpg";s:11:"image_large";s:18:"img/project/22.jpg";s:7:"metrics";a:4:{s:7:"Latency";s:14:"< 800ms Stream";s:10:"Automation";s:13:"80% Reduction";s:10:"Uptime SLA";s:5:"99.9%";s:13:"Cloud Savings";s:13:"-35% Overhead";}s:5:"stack";a:9:{i:0;s:7:"Next.js";i:1;s:5:"React";i:2;s:7:"Node.js";i:3;s:10:"TypeScript";i:4;s:9:"LangChain";i:5;s:10:"OpenAI API";i:6;s:13:"Google Gemini";i:7;s:26:"AWS (Lambda, S3, DynamoDB)";i:8;s:12:"Tailwind CSS";}s:24:"architectural_highlights";a:4:{i:0;s:196:"Retrieval-Augmented Generation (RAG): Built resilient vector search pipelines that ingest multi-format corporate knowledge repositories and inject contextual reference frames into dynamic prompts.";i:1;s:181:"AWS Serverless Migration: Transitioned legacy monolithic containerized services to event-driven AWS Lambda, DynamoDB, and Amazon S3, slashing monthly operational cloud costs by 35%.";i:2;s:158:"Reliability & High Availability: Maintained a verified 99.9% uptime SLA across continuous agentic generative tasks for thousands of active multi-tenant users.";i:3;s:186:"Dynamic Semantic Synthesis: Built autonomous agents utilizing OpenAI GPT-4o and Google Gemini Pro for real-time editorial reviews, SEO metadata generation, and cross-platform publishing.";}s:17:"problem_statement";s:270:"Editorial and media teams spend hundreds of manual hours every week drafting boilerplate articles, cross-referencing brand guidelines, and formatting structured metadata across fragmented CMS instances, resulting in ballooning editorial costs and delayed time-to-market.";s:8:"solution";s:308:"Constructed a modern headless AI platform with high-speed Next.js frontend, Node.js agent microservices, LangChain orchestration, and serverless compute on AWS. Writers upload raw source documents, and the system automatically synthesizes verified multi-channel copy while maintaining full editorial control.";s:7:"gallery";a:4:{i:0;s:17:"img/project/2.jpg";i:1;s:17:"img/project/3.jpg";i:2;s:17:"img/project/1.jpg";i:3;s:17:"img/project/5.jpg";}s:8:"live_url";s:27:"https://fushionhubai.com.ng";}s:7:"doccure";a:20:{s:4:"slug";s:7:"doccure";s:5:"title";s:29:"Doccure Telemedicine Platform";s:8:"subtitle";s:39:"Healthcare Data & Consultation Platform";s:4:"role";s:24:"Founder & Lead Developer";s:6:"client";s:19:"Doccure Health Tech";s:4:"date";s:11:"2023 - 2024";s:8:"featured";b:1;s:15:"category_filter";s:27:"web healthtech applications";s:13:"category_name";s:10:"HealthTech";s:10:"categories";a:3:{i:0;s:10:"HealthTech";i:1;s:12:"Telemedicine";i:2;s:13:"Data Security";}s:7:"summary";s:145:"HIPAA-compliant telemedicine platform with Redis query acceleration cutting database latency by 50% and secure digital medical report generation.";s:5:"image";s:17:"img/project/3.jpg";s:11:"image_large";s:18:"img/project/33.jpg";s:7:"metrics";a:4:{s:8:"Security";s:15:"HIPAA / TLS 1.3";s:10:"DB Latency";s:11:"-50% Faster";s:10:"Signatures";s:13:"Cryptographic";s:12:"Availability";s:16:"High Concurrency";}s:5:"stack";a:7:{i:0;s:13:"PHP (Laravel)";i:1;s:10:"TypeScript";i:2;s:18:"MySQL / PostgreSQL";i:3;s:5:"Redis";i:4;s:22:"AWS S3 (KMS Encrypted)";i:5;s:12:"Tailwind CSS";i:6;s:6:"WebRTC";}s:24:"architectural_highlights";a:4:{i:0;s:202:"Database Index Clustering: Overhauled the relational database normalization, query profiling, composite index clustering, and Redis key-value caching to cut doctor-patient lookup query latencies by 50%.";i:1;s:196:"HIPAA-Compliant Document Pipeline: Built automated encrypted PDF generation for clinical diagnostic reports featuring validated practitioner cryptographic signatures and tamper-evident audit logs.";i:2;s:186:"Zero-Trust RBAC & Encryption: Enforced granular role-based access control (RBAC), KMS envelope encryption for resting health records on AWS S3, and strict TLS 1.3 in-transit protections.";i:3;s:159:"Real-Time Tele-Consultations: Configured resilient WebRTC signaling and session tokens to support real-time audio/video consultations with automated fallbacks.";}s:17:"problem_statement";s:229:"Healthcare portals often suffer from sluggish clinical history lookups, high consultation room latency, and precarious file storage that fails regulatory compliance for patient confidentiality and digital practitioner signatures.";s:8:"solution";s:283:"Engineered a high-performance clinical platform utilizing Laravel, Redis caching layers, PostgreSQL composite indices, and an AWS KMS-encrypted document repository. Designed the architecture to satisfy rigorous data privacy mandates while maintaining instantaneous UI responsiveness.";s:7:"gallery";a:4:{i:0;s:17:"img/project/3.jpg";i:1;s:17:"img/project/4.jpg";i:2;s:17:"img/project/6.jpg";i:3;s:17:"img/project/2.jpg";}s:8:"live_url";s:28:"https://doccure.morexweb.com";}s:8:"sokarlab";a:20:{s:4:"slug";s:8:"sokarlab";s:5:"title";s:23:"SOKARLAB LTD Frameworks";s:8:"subtitle";s:48:"Modular Backend & Distributed Diagnostic Systems";s:4:"role";s:18:"Software Architect";s:6:"client";s:12:"Sokarlab Ltd";s:4:"date";s:11:"2022 - 2023";s:8:"featured";b:0;s:15:"category_filter";s:22:"cloud applications web";s:13:"category_name";s:15:"Cloud & Systems";s:10:"categories";a:3:{i:0;s:21:"Software Architecture";i:1;s:18:"Modular Frameworks";i:2;s:6:"DevOps";}s:7:"summary";s:140:"Reusable modular backend framework that reduced standard boilerplate code by 60%, slashing MVP setup time for enterprise client initiatives.";s:5:"image";s:17:"img/project/4.jpg";s:11:"image_large";s:18:"img/project/44.jpg";s:7:"metrics";a:4:{s:10:"Monitoring";s:21:"Automated Diagnostics";s:11:"Boilerplate";s:14:"-60% Reduction";s:12:"MVP Delivery";s:8:"2x Speed";s:13:"Test Coverage";s:3:"94%";}s:5:"stack";a:7:{i:0;s:10:"TypeScript";i:1;s:7:"Node.js";i:2;s:7:"PHP 8.2";i:3;s:7:"Express";i:4;s:10:"PostgreSQL";i:5;s:6:"Docker";i:6;s:14:"GitHub Actions";}s:24:"architectural_highlights";a:3:{i:0;s:192:"Reusable Architectural Blueprint: Created a modular scaffolding architecture that decoupled domain business logic from infrastructure adapters, reducing new project initialization code by 60%.";i:1;s:193:"Centralized Health Diagnostics: Built automated error reporting, request tracing, and latency monitoring hooks to alert distributed engineering teams before clients detect service degradations.";i:2;s:181:"Strict CI/CD Pipelines: Enforced automated linting, security scanning, and unit/integration test gates through GitHub Actions before any artifact promotion to staging or production.";}s:17:"problem_statement";s:202:"Frequent technical client launches suffered from redundant boilerplate setup, inconsistent error handling, divergent database migration strategies, and scattered logging across different micro-services.";s:8:"solution";s:211:"Engineered a unified enterprise boilerplate framework that standardized authentication, database abstraction, logging, and continuous deployment workflows, halving time-to-market across multiple client products.";s:7:"gallery";a:4:{i:0;s:17:"img/project/4.jpg";i:1;s:17:"img/project/5.jpg";i:2;s:17:"img/project/1.jpg";i:3;s:17:"img/project/6.jpg";}s:8:"live_url";s:20:"https://sokarlab.com";}s:14:"oma-audiobooks";a:20:{s:4:"slug";s:14:"oma-audiobooks";s:5:"title";s:23:"Oma Audiobooks Platform";s:8:"subtitle";s:53:"AI-Driven Audio Streaming & Behavioral Recommendation";s:4:"role";s:23:"Senior Backend Engineer";s:6:"client";s:15:"Oma Media Group";s:4:"date";s:11:"2022 - 2023";s:8:"featured";b:0;s:15:"category_filter";s:15:"ai applications";s:13:"category_name";s:14:"AI & Streaming";s:10:"categories";a:3:{i:0;s:7:"AI / ML";i:1;s:15:"Audio Streaming";i:2;s:10:"Mobile API";}s:7:"summary";s:150:"Integrated a behavioral machine learning recommendation engine that boosted average user session duration by 40% with adaptive bitrate audio delivery.";s:5:"image";s:17:"img/project/5.jpg";s:11:"image_large";s:18:"img/project/55.jpg";s:7:"metrics";a:4:{s:7:"Latency";s:19:"< 150ms Chunk Start";s:9:"Retention";s:12:"+28% Monthly";s:10:"Engagement";s:17:"+40% Session Time";s:10:"Throughput";s:16:"10k+ Concurrents";}s:5:"stack";a:6:{i:0;s:7:"Node.js";i:1;s:8:"Firebase";i:2;s:6:"Python";i:3;s:27:"Machine Learning Algorithms";i:4;s:12:"Google Cloud";i:5;s:11:"RESTful API";}s:24:"architectural_highlights";a:3:{i:0;s:186:"Behavioral ML Recommender: Integrated a user listening habit vector model in Python that dynamically recommended chapters, authors, and genres, elevating user engagement duration by 40%.";i:1;s:157:"Optimized Audio Chunk Streaming: Implemented byte-range chunk streaming that eliminated buffering stutter on spotty 3G/4G cellular connections across Africa.";i:2;s:170:"Real-Time Playhead Sync: Engineered Firebase real-time synchronization so users seamlessly switch between mobile apps and web players with zero loss of bookmark position.";}s:17:"problem_statement";s:151:"Users experienced high audio buffering latency and poor personalized discovery, leading to high drop-off rates within the first 5 minutes of listening.";s:8:"solution";s:165:"Engineered an adaptive byte-range audio streaming pipeline paired with a collaborative-filtering recommendation model, drastically improving retention and discovery.";s:7:"gallery";a:4:{i:0;s:17:"img/project/5.jpg";i:1;s:17:"img/project/6.jpg";i:2;s:17:"img/project/2.jpg";i:3;s:17:"img/project/3.jpg";}s:8:"live_url";s:20:"https://omaaudio.com";}s:18:"quantum-pay-escrow";a:20:{s:4:"slug";s:18:"quantum-pay-escrow";s:5:"title";s:56:"QuantumPay: Real-Time B2B Multi-Currency Escrow Platform";s:8:"subtitle";s:56:"Instantaneous Settlement with Cryptographic Verification";s:4:"role";s:36:"Chief Architect & Technical Director";s:6:"client";s:17:"QuantumPay Global";s:4:"date";s:4:"2026";s:8:"featured";b:1;s:15:"category_filter";s:7:"fintech";s:13:"category_name";s:22:"FinTech Infrastructure";s:10:"categories";a:3:{i:0;s:7:"FinTech";i:1;s:18:"Cloud Architecture";i:2;s:14:"Escrow Systems";}s:7:"summary";s:86:"Engineered an institutional-grade B2B payments orchestrator with real-time settlement.";s:5:"image";s:22:"img/project/crypto.jpg";s:11:"image_large";s:22:"imgprojectcrypto-1.jpg";s:7:"metrics";a:2:{i:0;a:2:{s:5:"label";s:22:"Gross Volume Processed";s:5:"value";s:5:"$85M+";}i:1;a:2:{s:5:"label";s:19:"Settlement Accuracy";s:5:"value";s:6:"99.99%";}}s:5:"stack";a:5:{i:0;s:7:"PHP 8.3";i:1;s:10:"Laravel 11";i:2;s:13:"Redis Cluster";i:3;s:10:"PostgreSQL";i:4;s:7:"AWS ECS";}s:24:"architectural_highlights";a:2:{i:0;s:65:"Idempotent transactional pipeline with distributed Redis locking.";i:1;s:67:"Zero-trust cryptographic tokenization for banking partner webhooks.";}s:17:"problem_statement";s:83:"Previous gateway experienced double-spend vulnerabilities under network partitions.";s:8:"solution";s:89:"Architected a distributed two-phase commit escrow pipeline with automated reconciliation.";s:7:"gallery";a:1:{i:0;s:24:"img/portfolio/item-1.png";}s:8:"live_url";s:30:"https://quantumpay.example.com";}}}